# 复制为 .env（开发用）。exe 模式改读 %LOCALAPPDATA%\ScanableSelf\config.ini，勿依赖 .env
# 变量名不得修改（CODEBUDDY.md 禁止事项 4）。完整语义见 docs/01 第 20 章

APP_ENV=dev                      # dev | prod
SECRET_KEY=                      # 留空则首次启动随机生成并持久化；轮换会失效全部网页登录（Token 不受影响）

BIND_HOST=0.0.0.0                # 多网卡误选时可指定单个局域网 IP（见 T-14）
HTTP_PORT=5000                   # 被占自动 +1 至 5010（T/PRD 5.8）
AUTO_SWITCH_PORT=true

DB_PATH=                         # 留空=默认（dev: ./data/inventory.db；exe: %LOCALAPPDATA%）

BROADCAST_ENABLED=true           # 测试环境必须 false（30-testing-rules.md）
BROADCAST_INTERVAL_MS=3000       # 1000~10000
BROADCAST_PORT=55555
UDP_TARGET=255.255.255.255       # 先试子网定向广播，失败回落此值（T-13）
SERVER_NAME=ScanableSelf         # 广播 NAME 字段，可含空格（必须置于报文最后，T-12）

LOG_LEVEL=INFO                   # DEBUG 仅限临时排查（T-22 之外的日志量控制）
BACKUP_ENABLED=true
BACKUP_TIME=03:00
BACKUP_KEEP=7

LOGIN_MAX_FAIL=5
LOGIN_LOCK_SECONDS=900
SYNC_BATCH_MAX=200
LOW_STOCK_ALERT=true
LICENSE_ENFORCED=true            # 未激活时全站拦截（离线授权，见 docs/11）；仅测试环境置 false

FEATURE_UDP=true                 # 发现能力降级开关
FEATURE_SYNC_BATCH=true          # 批量同步开关
FEATURE_ADJUST=true              # 盘点开关
